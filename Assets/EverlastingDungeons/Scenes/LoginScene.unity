--- !u!1001 &1876497310
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 163590192}
    m_Modifications:
    - target: {fileID: 240428768818122195, guid: 7528917a249018c40ab4335ccecb7420, type: 3}
      propertyPath: m_Name
      value: Info
      objectReference: {fileID: 0}
    - target: {fileID: 4382241809103320246, guid: 7528917a249018c40ab4335ccecb7420, type: 3}
      propertyPath: m_text
      value: 'You can interact with the NPCs at town by clicking them, remember to
        be within their range to do so.


        <color=red>Keybindings:</color>

        <color=yellow>W,A,S,D
        (Or arrows)</color> - Controls your character.

        <color=yellow>Q,
        E, R</color> - Spell Hotkeys (Assigned from the Spell Assignment GUI)

        <color=yellow>1,
        2, 3, 4, 5, 6</color> - Consumable Hotkeys (Assigned from the Consumable
        Assignment GUI)

        <color=yellow>Escape</color> - Used to open game
        settings, or to close the current tab.

        <color=yellow>Space</color>
        - Used to loot nearby items.

        <color=yellow>CTRL</color> - Used to
        target the nearest enemy.

        <color=yellow>I</color> - Opens your inventory
        tab.

        <color=yellow>G</color> - Opens your gear tab.

        <color=yellow>M</color>
        - Opens the mastery and stats tab.

        <color=yellow>C</color> - Opens
        the consumable assignment tab.

        <color=yellow>H</color> - Opens the
        spell assignment tab.'
      objectReference: {fileID: 0}
    - target: {fileID: 4382241809103320246, guid: 7528917a249018c40ab4335ccecb7420, type: 3}
